{
  "name": "@josephbrendan/frame-relay",
  "version": "0.1.0-beta.0",
  "description": "Turn your Figma components into a design kit your AI coding agent follows.",
  "license": "MIT",
  "author": "Joseph Brendan",
  "type": "module",
  "bin": {
    "frame-relay": "dist/cli.js"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "publishConfig": {
    "access": "public",
    "tag": "beta"
  },
  "engines": {
    "node": ">=20"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Joseph-Brendan/Frame-Relay.git",
    "directory": "packages/cli"
  },
  "homepage": "https://joseph-brendan.github.io/Frame-Relay/",
  "bugs": {
    "url": "https://github.com/Joseph-Brendan/Frame-Relay/issues"
  },
  "keywords": [
    "figma",
    "mcp",
    "design-system",
    "ai-agents",
    "tailwind",
    "react"
  ],
  "mcpName": "io.github.Joseph-Brendan/frame-relay",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsup",
    "typecheck": "tsc --noEmit",
    "prepack": "node scripts/copy-npm-files.mjs"
  },
  "dependencies": {
    "@babel/parser": "^7.29.9",
    "@clack/prompts": "^1.8.1",
    "@modelcontextprotocol/sdk": "^1.32.0",
    "cac": "^6.7.14",
    "chokidar": "^5.0.0",
    "fast-glob": "^3.3.3",
    "jszip": "^3.10.1",
    "picocolors": "^1.1.1",
    "prettier": "^3.5.1",
    "ws": "^8.22.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@josephbrendan/converter": "workspace:*",
    "@josephbrendan/schema": "workspace:*",
    "@types/ws": "^8.18.2",
    "tsup": "^8.3.6",
    "typescript": "^5.7.3"
  }
}
