{
  "color": {
    "$type": "color",
    "primary": {
      "500": {
        "$value": "#2563eb",
        "$extensions": {
          "frame-relay": {
            "modes": {
              "dark": "#3b82f6"
            }
          }
        }
      },
      "600": {
        "$value": "#1d4ed8",
        "$extensions": {
          "frame-relay": {
            "modes": {
              "dark": "#2563eb"
            }
          }
        }
      }
    },
    "neutral": {
      "0": {
        "$value": "#ffffff",
        "$extensions": {
          "frame-relay": {
            "modes": {
              "dark": "#0f172a"
            }
          }
        }
      },
      "100": {
        "$value": "#f1f5f9",
        "$extensions": {
          "frame-relay": {
            "modes": {
              "dark": "#1e293b"
            }
          }
        }
      },
      "300": {
        "$value": "#cbd5e1",
        "$extensions": {
          "frame-relay": {
            "modes": {
              "dark": "#334155"
            }
          }
        }
      },
      "500": {
        "$value": "#64748b",
        "$extensions": {
          "frame-relay": {
            "modes": {
              "dark": "#94a3b8"
            }
          }
        }
      },
      "900": {
        "$value": "#0f172a",
        "$extensions": {
          "frame-relay": {
            "modes": {
              "dark": "#f8fafc"
            }
          }
        }
      }
    },
    "danger": {
      "500": {
        "$value": "#ef4444",
        "$extensions": {
          "frame-relay": {
            "modes": {
              "dark": "#f87171"
            }
          }
        }
      }
    },
    "focus": {
      "ring": {
        "$value": "#93c5fd",
        "$extensions": {
          "frame-relay": {
            "modes": {
              "dark": "#1d4ed8"
            }
          }
        }
      }
    }
  },
  "radius": {
    "$type": "dimension",
    "sm": {
      "$value": "6px"
    },
    "md": {
      "$value": "12px"
    },
    "lg": {
      "$value": "16px"
    },
    "full": {
      "$value": "999px"
    }
  },
  "space": {
    "$type": "dimension",
    "1": {
      "$value": "4px"
    },
    "2": {
      "$value": "8px"
    },
    "3": {
      "$value": "12px"
    },
    "4": {
      "$value": "16px"
    },
    "5": {
      "$value": "20px"
    },
    "6": {
      "$value": "24px"
    },
    "7": {
      "$value": "28px"
    },
    "8": {
      "$value": "32px"
    }
  },
  "font": {
    "family": {
      "$type": "fontFamily",
      "sans": {
        "$value": "Inter, system-ui, sans-serif"
      }
    },
    "weight": {
      "$type": "fontWeight",
      "400": {
        "$value": "400"
      },
      "500": {
        "$value": "500"
      },
      "600": {
        "$value": "600"
      }
    }
  },
  "typography": {
    "$type": "typography",
    "body": {
      "$value": {
        "fontFamily": "{font.family.sans}",
        "fontSize": "16px",
        "fontWeight": "{font.weight.400}",
        "lineHeight": "24px"
      }
    },
    "label": {
      "$value": {
        "fontFamily": "{font.family.sans}",
        "fontSize": "14px",
        "fontWeight": "{font.weight.500}",
        "lineHeight": "20px"
      }
    },
    "button": {
      "$value": {
        "fontFamily": "{font.family.sans}",
        "fontSize": "14px",
        "fontWeight": "{font.weight.600}",
        "lineHeight": "20px"
      }
    }
  },
  "shadow": {
    "$type": "shadow",
    "sm": {
      "$value": "0 1px 2px 0 rgba(0, 0, 0, 0.05)"
    },
    "md": {
      "$value": "0 4px 6px -1px rgba(0, 0, 0, 0.1), 0 2px 4px -2px rgba(0, 0, 0, 0.1)"
    }
  },
  "border": {
    "$type": "border",
    "default": {
      "$value": "1px solid {color.neutral.300}"
    },
    "focus": {
      "$value": "2px solid {color.focus.ring}"
    }
  }
}
